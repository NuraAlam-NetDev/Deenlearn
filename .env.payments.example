# ---- Payments (add these to server/.env) ----
# Public URL of the API. The gateways must reach it (callbacks/webhooks). Local dev: use ngrok, e.g. https://abc.ngrok-free.app
PUBLIC_API_URL=http://localhost:5000
# Where students land after paying (the React app)
CLIENT_URL=http://localhost:5173

# SSLCommerz (bKash, Nagad, local cards). Sandbox store from developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true

# Stripe (international cards, USD). Test keys from dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
