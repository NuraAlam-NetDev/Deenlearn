# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# Replace <username>, <password>, <cluster>; keep the database name (deenlearn)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/deenlearn?retryWrites=true&w=majority

# Auth: two DIFFERENT long random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Cookies: lax works when client and API share a site (dev proxy / same domain).
# Use "none" only if client and API are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=